        "jsCode": "const text = ($json.output || '').toString().trim();\n\nconst maxLen = 350;\nconst maxParts = 5;\n\nfunction splitTextPreservingMeaning(input, maxLen) {\n  if (!input) return [];\n\n  const paragraphs = input\n    .split(/\\n{2,}/)\n    .map(p => p.trim())\n    .filter(Boolean);\n\n  const chunks = [];\n\n  for (const paragraph of paragraphs) {\n    if (paragraph.length <= maxLen) {\n      chunks.push(paragraph);\n      continue;\n    }\n\n    const sentences = paragraph.match(/[^.!?]+[.!?]?/g) || [paragraph];\n    let current = '';\n\n    for (const sentence of sentences) {\n      const s = sentence.trim();\n      if (!s) continue;\n\n      if ((current + ' ' + s).trim().length <= maxLen) {\n        current = (current + ' ' + s).trim();\n      } else {\n        if (current) chunks.push(current);\n\n        if (s.length <= maxLen) {\n          current = s;\n        } else {\n          // Si una sola oración supera el límite, partir por longitud\n          for (let i = 0; i < s.length; i += maxLen) {\n            chunks.push(s.slice(i, i + maxLen).trim());\n          }\n          current = '';\n        }\n      }\n    }\n\n    if (current) chunks.push(current);\n  }\n\n  return chunks;\n}\n\nlet parts = splitTextPreservingMeaning(text, maxLen).slice(0, maxParts);\n\n// Si sobran partes, las unimos en la última\nif (splitTextPreservingMeaning(text, maxLen).length > maxParts) {\n  const all = splitTextPreservingMeaning(text, maxLen);\n  parts = all.slice(0, maxParts - 1);\n  parts.push(all.slice(maxParts - 1).join('\\n\\n'));\n}\n\n// Rellenar hasta 5 partes\nwhile (parts.length < maxParts) {\n  parts.push('');\n}\n\nreturn [\n  {\n    json: {\n      output: {\n        Response: {\n          part_1: parts[0],\n          part_2: parts[1],\n          part_3: parts[2],\n          part_4: parts[3],\n          part_5: parts[4],\n        }\n      }\n    }\n  }\n];"
