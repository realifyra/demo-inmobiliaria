        <script>
            (function() {
                const WEBHOOK_URL = <?php echo json_encode($webhook_url); ?>;
                const form = document.getElementById('chaton-property-form');
                const statusEl = document.getElementById('chaton-form-status');
                const propertyIdInput = document.getElementById('property_id');
                const createdAtInput = document.getElementById('created_at');
                const updatedAtInput = document.getElementById('updated_at');

                function pad(n) {
                    return n < 10 ? '0' + n : n;
                }

                function getNowFormatted() {
                    const now = new Date();
                    return now.getFullYear() + '-' +
                        pad(now.getMonth() + 1) + '-' +
                        pad(now.getDate()) + ' ' +
                        pad(now.getHours()) + ':' +
                        pad(now.getMinutes()) + ':' +
                        pad(now.getSeconds());
                }

                function generatePropertyId() {
                    const now = new Date();
                    return 'PROP-' +
                        now.getFullYear().toString() +
                        pad(now.getMonth() + 1) +
                        pad(now.getDate()) + '-' +
                        pad(now.getHours()) +
                        pad(now.getMinutes()) +
                        pad(now.getSeconds());
                }

                function seedDefaults() {
                    const now = getNowFormatted();
                    createdAtInput.value = now;
                    updatedAtInput.value = now;

                    if (!propertyIdInput.value.trim()) {
                        propertyIdInput.value = generatePropertyId();
                    }
                }

                function getCheckedAmenities() {
                    return Array.from(document.querySelectorAll('input[name="amenities[]"]:checked')).map(el => el.value);
                }

                seedDefaults();

                form.addEventListener('submit', async function(e) {
                    e.preventDefault();

                    statusEl.textContent = '';
                    statusEl.className = 'chaton-form-status';

                    if (!WEBHOOK_URL || WEBHOOK_URL === 'PON_AQUI_TU_WEBHOOK_DE_N8N') {
                        statusEl.textContent = 'Falta configurar la URL del webhook de n8n.';
                        statusEl.classList.add('error');
                        return;
                    }

                    updatedAtInput.value = getNowFormatted();

                    const mainImageInput = document.getElementById('main_image');
                    const galleryInput = document.getElementById('gallery_images');

                    const payload = {
                        property_id: document.getElementById('property_id').value.trim(),
                        property_name: document.getElementById('property_name').value.trim(),
                        property_type: document.getElementById('property_type').value,
                        operation_type: document.getElementById('operation_type').value,
                        property_status: document.getElementById('property_status').value,

                        state: document.getElementById('state').value.trim(),
                        city: document.getElementById('city').value.trim(),
                        zone: document.getElementById('zone').value.trim(),
                        address: document.getElementById('address').value.trim(),
                        maps_url: document.getElementById('maps_url').value.trim(),

                        price: document.getElementById('price').value,
                        currency: document.getElementById('currency').value,
                        land_area_m2: document.getElementById('land_area_m2').value,
                        construction_area_m2: document.getElementById('construction_area_m2').value,
                        frontage_m: document.getElementById('frontage_m').value,
                        depth_m: document.getElementById('depth_m').value,

                        bedrooms: document.getElementById('bedrooms').value,
                        bathrooms: document.getElementById('bathrooms').value,
                        half_bathrooms: document.getElementById('half_bathrooms').value,
                        parking_spaces: document.getElementById('parking_spaces').value,

                        short_description: document.getElementById('short_description').value.trim(),
                        full_description: document.getElementById('full_description').value.trim(),
                        amenities: getCheckedAmenities(),
                        other_amenities: document.getElementById('other_amenities').value.trim(),

                        virtual_tour_url: document.getElementById('virtual_tour_url').value.trim(),

                        advisor_name: document.getElementById('advisor_name').value.trim(),
                        contact_phone: document.getElementById('contact_phone').value.trim(),
                        internal_notes: document.getElementById('internal_notes').value.trim(),
                        created_at: document.getElementById('created_at').value.trim(),
                        updated_at: document.getElementById('updated_at').value.trim(),

                        source: 'wordpress_form_chaton',
                        site_url: window.location.origin,
                        submitted_by: '<?php echo esc_js(wp_get_current_user()->user_login); ?>'
                    };

                    const formData = new FormData();
                    formData.append('payload', JSON.stringify(payload));

                    if (mainImageInput.files.length > 0) {
                        formData.append('main_image', mainImageInput.files[0]);
                    }

                    if (galleryInput.files.length > 0) {
                        Array.from(galleryInput.files).forEach((file, index) => {
                            formData.append('gallery_image_' + index, file);
                        });
                        formData.append('gallery_count', galleryInput.files.length);
                    } else {
                        formData.append('gallery_count', 0);
                    }

                    try {
                        statusEl.textContent = 'Enviando propiedad...';
                        const response = await fetch(WEBHOOK_URL, {
                            method: 'POST',
                            body: formData
                        });

                        if (!response.ok) {
                            throw new Error('HTTP ' + response.status);
                        }

                        statusEl.textContent = '✅ Propiedad enviada correctamente.';
                        statusEl.classList.add('ok');
						
						
						if (window.chatonPropsReload) {
    setTimeout(() => {
        window.chatonPropsReload();
    }, 1200);
}

                        form.reset();
                        seedDefaults();

                    } catch (error) {
                        console.error(error);
                        statusEl.textContent = '❌ Ocurrió un error al enviar la propiedad.';
                        statusEl.classList.add('error');
                    }
                });
            })();
        </script>
