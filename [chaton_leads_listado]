            const modalTitle = document.getElementById('chaton-lead-modal-title');
            const modalClose = document.getElementById('chaton-lead-modal-close');
            const modalFooterClose = document.getElementById('chaton-lead-modal-footer-close');
            const summaryBox = document.getElementById('chaton-lead-summary-box');
            const waThread = document.getElementById('chaton-wa-thread');

            if (modal && modal.parentNode !== document.body) {
                document.body.appendChild(modal);
            }

            let allRows = [];
            let currentLeadRow = null;

            function escapeHtml(str) {
                return String(str || '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            function normalizeText(str) {
                return String(str || '')
                    .normalize('NFD')
                    .replace(/[\u0300-\u036f]/g, '')
                    .toLowerCase()
                    .trim();
            }

            function pickVal(obj, keys) {
                for (const key of keys) {
                    if (typeof obj[key] !== 'undefined' && obj[key] !== null && obj[key] !== '') {
                        return obj[key];
                    }
                }
                return '';
            }

            function extractRows(response) {
                if (Array.isArray(response)) return response;
                if (response && Array.isArray(response.data)) return response.data;
                if (response && Array.isArray(response.rows)) return response.rows;
                if (response && Array.isArray(response.items)) return response.items;
                return [];
            }

            function getLeadFieldMap(row) {
                return {
                    client_id: pickVal(row, ['ID Cliente', 'client_id', 'id_cliente']),
                    last_interaction: pickVal(row, ['Fecha y hora ultima interaccion', 'ultima_interaccion', 'updated_at']),
                    full_name: pickVal(row, ['Nombre Completo', 'nombre_completo', 'name']),
                    phone: pickVal(row, ['Telefono', 'Teléfono', 'phone', 'telefono']),
                    email: pickVal(row, ['Email', 'email']),
                    property_type: pickVal(row, ['Tipo de Propiedad Deseada', 'tipo_propiedad_deseada']),
                    operation_type: pickVal(row, ['Tipo de Operacion Deseada', 'tipo_operacion_deseada']),
                    location: pickVal(row, ['Ubicacion deseada', 'ubicacion_deseada']),
                    budget_min: pickVal(row, ['Presupuesto minimo', 'presupuesto_minimo']),
                    budget_max: pickVal(row, ['Presupuesto maximo', 'presupuesto_maximo']),
                    decision_timeline: pickVal(row, ['Plazo para decidir/requerir', 'plazo_para_decidir_requerir']),
                    size_m2: pickVal(row, ['Tamaño m² Deseado', 'tamano_m2_deseado']),
                    bedrooms: pickVal(row, ['Num de Habitaciones Deseadas', 'habitaciones_deseadas']),
                    bathrooms: pickVal(row, ['Num de Baños Deseados', 'banos_deseados']),
                    half_bathrooms: pickVal(row, ['Num de Medios Baños Deseados', 'medios_banos_deseados']),
                    parking_spaces: pickVal(row, ['Lugares de Autos Deseados', 'lugares_autos_deseados']),
                    elevator: pickVal(row, ['Ascensor Deseado (si/no)', 'ascensor_deseado']),
                    green_area: pickVal(row, ['Area Verde (si/no)', 'area_verde']),
                    pool: pickVal(row, ['Piscina (si/no)', 'piscina']),
                    client_status: pickVal(row, ['Estado del Cliente', 'estado_cliente']),
                    additional_preferences: pickVal(row, ['Preferencias Adicionales', 'preferencias_adicionales']),
                    conversation_summary: pickVal(row, ['Resumen de conversacion', 'resumen_de_conversacion'])
                };
            }

            function getHistoryFieldMap(row) {
                return {
                    date_time: pickVal(row, ['Fecha y hora', 'date_time', 'fecha_hora']),
                    phone: pickVal(row, ['Teléfono', 'Telefono', 'phone', 'telefono']),
                    direction: pickVal(row, ['Dirección', 'Direccion', 'direction']),
                    author: pickVal(row, ['Autor', 'author']),
                    message_type: pickVal(row, ['Tipo de mensaje', 'message_type']),
                    message: pickVal(row, ['Mensaje', 'message', 'texto']),
                    instance: pickVal(row, ['Instancia', 'instance'])
                };
            }

            function uniqueSortedValues(rows, fieldName) {
                const values = rows
                    .map(row => getLeadFieldMap(row)[fieldName])
                    .filter(Boolean)
                    .map(v => String(v).trim());

                return [...new Set(values)].sort((a, b) => a.localeCompare(b, 'es'));
            }

            function populateDynamicFilters() {
                const statuses = uniqueSortedValues(allRows, 'client_status');
                const operations = uniqueSortedValues(allRows, 'operation_type');
                const locations = uniqueSortedValues(allRows, 'location');
                const types = uniqueSortedValues(allRows, 'property_type');

                statusFilter.innerHTML = '<option value="">Todos los estados</option>' +
                    statuses.map(v => `<option value="${escapeHtml(v)}">${escapeHtml(v)}</option>`).join('');

                operationFilter.innerHTML = '<option value="">Todas las operaciones</option>' +
                    operations.map(v => `<option value="${escapeHtml(v)}">${escapeHtml(v)}</option>`).join('');

                locationFilter.innerHTML = '<option value="">Todas las ubicaciones</option>' +
                    locations.map(v => `<option value="${escapeHtml(v)}">${escapeHtml(v)}</option>`).join('');

                typeFilter.innerHTML = '<option value="">Todos los tipos</option>' +
                    types.map(v => `<option value="${escapeHtml(v)}">${escapeHtml(v)}</option>`).join('');
            }

            function statusClass(status) {
                const val = normalizeText(status).replace(/\s+/g, '');
                if (val === 'nuevo') return 'nuevo';
                if (val === 'calificando') return 'calificando';
                if (val === 'interesado') return 'interesado';
                if (val === 'citaagendada') return 'citaagendada';
                if (val === 'seguimientohumano') return 'seguimientohumano';
                return 'nointeresado';
            }

            function rowMatches(row, term, status, operation, location, type) {
                const m = getLeadFieldMap(row);

                const haystack = normalizeText([
                    m.client_id,
                    m.full_name,
                    m.phone,
                    m.email,
                    m.property_type,
                    m.operation_type,
                    m.location,
                    m.client_status,
                    m.conversation_summary,
                    m.additional_preferences
                ].join(' '));

                const matchesTerm = !term || haystack.includes(term);
                const matchesStatus = !status || normalizeText(m.client_status) === normalizeText(status);
                const matchesOperation = !operation || normalizeText(m.operation_type) === normalizeText(operation);
                const matchesLocation = !location || normalizeText(m.location) === normalizeText(location);
                const matchesType = !type || normalizeText(m.property_type) === normalizeText(type);

                return matchesTerm && matchesStatus && matchesOperation && matchesLocation && matchesType;
            }

            function buildBudgetText(m) {
                if (!m.budget_min && !m.budget_max) return 'No registrado';
                if (m.budget_min && m.budget_max) return escapeHtml(m.budget_min + ' - ' + m.budget_max);
                return escapeHtml(m.budget_min || m.budget_max);
            }

            function renderRows() {
                const term = normalizeText(searchInput.value);
                const status = statusFilter.value;
                const operation = operationFilter.value;
                const location = locationFilter.value;
                const type = typeFilter.value;

                const filtered = allRows.filter(row => rowMatches(row, term, status, operation, location, type));

                countEl.textContent = filtered.length + (filtered.length === 1 ? ' lead' : ' leads');

                if (!filtered.length) {
                    tbody.innerHTML = '<tr><td colspan="10">No se encontraron leads con esos filtros.</td></tr>';
                    cards.innerHTML = '<div class="chaton-prop-card"><p>No se encontraron leads con esos filtros.</p></div>';
                    return;
                }

                tbody.innerHTML = filtered.map((row) => {
                    const m = getLeadFieldMap(row);
                    return `
                        <tr>
                            <td>${escapeHtml(m.client_id)}</td>
                            <td>
                                <strong>${escapeHtml(m.full_name || 'Sin nombre')}</strong>
                                ${m.conversation_summary ? `<div style="margin-top:4px;color:#64748b;font-size:12px;">${escapeHtml(m.conversation_summary)}</div>` : ''}
                            </td>
                            <td>
                                <div>${escapeHtml(m.phone || 'Sin teléfono')}</div>
                                ${m.email ? `<div style="margin-top:4px;color:#64748b;font-size:12px;">${escapeHtml(m.email)}</div>` : ''}
                            </td>
                            <td>${escapeHtml(m.operation_type || 'No registrada')}</td>
                            <td>${escapeHtml(m.property_type || 'No registrada')}</td>
                            <td>${escapeHtml(m.location || 'No registrada')}</td>
                            <td>${buildBudgetText(m)}</td>
                            <td><span class="chaton-status-pill ${statusClass(m.client_status)}">${escapeHtml(m.client_status || 'Sin estado')}</span></td>
                            <td>${escapeHtml(m.last_interaction || 'No registrada')}</td>
                            <td>
                                <div class="chaton-row-actions">
                                    <button type="button" class="chaton-btn-detail chaton-lead-detail-btn" data-client-id="${escapeHtml(m.client_id)}">Ver conversación</button>
                                    <button type="button" class="chaton-btn-danger chaton-lead-delete-btn" data-client-id="${escapeHtml(m.client_id)}" data-phone="${escapeHtml(m.phone)}">Eliminar</button>
                                </div>
                            </td>
                        </tr>
                    `;
                }).join('');

                cards.innerHTML = filtered.map((row) => {
                    const m = getLeadFieldMap(row);
                    return `
                        <div class="chaton-prop-card">
                            <div style="display:flex;justify-content:space-between;gap:10px;align-items:flex-start;">
                                <div>
                                    <h4>${escapeHtml(m.full_name || 'Sin nombre')}</h4>
                                    <p>${escapeHtml(m.client_id)}</p>
                                </div>
                                <span class="chaton-status-pill ${statusClass(m.client_status)}">${escapeHtml(m.client_status || 'Sin estado')}</span>
                            </div>

                            <div class="chaton-card-meta">
                                <div><strong>Teléfono</strong>${escapeHtml(m.phone || 'Sin teléfono')}</div>
                                <div><strong>Email</strong>${escapeHtml(m.email || 'Sin email')}</div>
                                <div><strong>Operación</strong>${escapeHtml(m.operation_type || 'No registrada')}</div>
                                <div><strong>Propiedad</strong>${escapeHtml(m.property_type || 'No registrada')}</div>
                                <div><strong>Ubicación</strong>${escapeHtml(m.location || 'No registrada')}</div>
                                <div><strong>Presupuesto</strong>${buildBudgetText(m)}</div>
                                <div><strong>Última interacción</strong>${escapeHtml(m.last_interaction || 'No registrada')}</div>
                            </div>

                            ${m.conversation_summary ? `<p>${escapeHtml(m.conversation_summary)}</p>` : ''}

                            <div class="chaton-card-actions">
                                <button type="button" class="chaton-btn-detail chaton-lead-detail-btn" data-client-id="${escapeHtml(m.client_id)}">Ver conversación</button>
                                <button type="button" class="chaton-btn-danger chaton-lead-delete-btn" data-client-id="${escapeHtml(m.client_id)}" data-phone="${escapeHtml(m.phone)}">Eliminar</button>
                            </div>
                        </div>
                    `;
                }).join('');
            }

            function buildSummaryHtml(row) {
                const m = getLeadFieldMap(row);
                return `
                    <h4>Resumen del lead</h4>
                    <div class="chaton-detail-grid">
                        <div class="chaton-detail-item"><strong>ID Cliente</strong><span>${escapeHtml(m.client_id)}</span></div>
                        <div class="chaton-detail-item"><strong>Estado del cliente</strong><span>${escapeHtml(m.client_status || 'No registrado')}</span></div>
                        <div class="chaton-detail-item"><strong>Nombre</strong><span>${escapeHtml(m.full_name || 'No registrado')}</span></div>
                        <div class="chaton-detail-item"><strong>Teléfono</strong><span>${escapeHtml(m.phone || 'No registrado')}</span></div>
                        <div class="chaton-detail-item"><strong>Email</strong><span>${escapeHtml(m.email || 'No registrado')}</span></div>
                        <div class="chaton-detail-item"><strong>Última interacción</strong><span>${escapeHtml(m.last_interaction || 'No registrada')}</span></div>
                        <div class="chaton-detail-item"><strong>Tipo de operación</strong><span>${escapeHtml(m.operation_type || 'No registrado')}</span></div>
                        <div class="chaton-detail-item"><strong>Tipo de propiedad</strong><span>${escapeHtml(m.property_type || 'No registrado')}</span></div>
                        <div class="chaton-detail-item"><strong>Ubicación deseada</strong><span>${escapeHtml(m.location || 'No registrada')}</span></div>
                        <div class="chaton-detail-item"><strong>Presupuesto</strong><span>${buildBudgetText(m)}</span></div>
                        <div class="chaton-detail-item"><strong>Tamaño m²</strong><span>${escapeHtml(m.size_m2 || 'No registrado')}</span></div>
                        <div class="chaton-detail-item"><strong>Habitaciones</strong><span>${escapeHtml(m.bedrooms || 'No registrado')}</span></div>
                        <div class="chaton-detail-item"><strong>Baños</strong><span>${escapeHtml(m.bathrooms || 'No registrado')}</span></div>
                        <div class="chaton-detail-item"><strong>Medios baños</strong><span>${escapeHtml(m.half_bathrooms || 'No registrado')}</span></div>
                        <div class="chaton-detail-item"><strong>Lugares de auto</strong><span>${escapeHtml(m.parking_spaces || 'No registrado')}</span></div>
                        <div class="chaton-detail-item"><strong>Ascensor</strong><span>${escapeHtml(m.elevator || 'No registrado')}</span></div>
                        <div class="chaton-detail-item"><strong>Área verde</strong><span>${escapeHtml(m.green_area || 'No registrado')}</span></div>
                        <div class="chaton-detail-item"><strong>Piscina</strong><span>${escapeHtml(m.pool || 'No registrado')}</span></div>
                        <div class="chaton-detail-item"><strong>Plazo</strong><span>${escapeHtml(m.decision_timeline || 'No registrado')}</span></div>
                        <div class="chaton-detail-item chaton-detail-full"><strong>Preferencias adicionales</strong><span>${escapeHtml(m.additional_preferences || 'Sin preferencias registradas')}</span></div>
                        <div class="chaton-detail-item chaton-detail-full"><strong>Resumen</strong><span>${escapeHtml(m.conversation_summary || 'Sin resumen registrado')}</span></div>
                    </div>
                `;
            }

            function toTimestamp(value) {
                const parsed = Date.parse(value);
                return isNaN(parsed) ? 0 : parsed;
            }

            function renderHistory(rows) {
                if (!rows.length) {
                    waThread.innerHTML = '<div class="chaton-wa-loading">No se encontró historial para este lead.</div>';
                    return;
                }

                const sorted = rows
                    .slice()
                    .sort((a, b) => toTimestamp(getHistoryFieldMap(b).date_time) - toTimestamp(getHistoryFieldMap(a).date_time));

                waThread.innerHTML = sorted.map((row) => {
                    const m = getHistoryFieldMap(row);
                    const direction = normalizeText(m.direction);
                    const bubbleClass = direction === 'saliente' ? 'saliente' : 'entrante';
                    return `
                        <div class="chaton-wa-msg ${bubbleClass}">
                            <div class="chaton-wa-meta">
                                <span>${escapeHtml(m.author || (bubbleClass === 'saliente' ? 'Liz Ortega' : 'Cliente'))}</span>
                                <span>${escapeHtml(m.date_time || 'Sin fecha')}</span>
                                ${m.message_type ? `<span>${escapeHtml(m.message_type)}</span>` : ''}
                            </div>
                            <div class="chaton-wa-text">${escapeHtml(m.message || 'Sin mensaje')}</div>
                        </div>
                    `;
                }).join('');
            }

            async function fetchHistoryForLead(row) {
                const m = getLeadFieldMap(row);
                const params = new URLSearchParams();
                if (m.client_id) params.append('client_id', m.client_id);
                if (m.phone) params.append('telefono', m.phone);

                const url = HISTORY_ENDPOINT + (params.toString() ? ('?' + params.toString()) : '');

                const response = await fetch(url, { method: 'GET' });
                if (!response.ok) {
                    throw new Error('HTTP ' + response.status);
                }
                const json = await response.json();
                return extractRows(json);
            }

            async function openLeadDetail(row) {
                currentLeadRow = row;
                const m = getLeadFieldMap(row);

                modalTitle.textContent = m.full_name || 'Lead sin nombre';
                summaryBox.innerHTML = buildSummaryHtml(row);
                waThread.innerHTML = '<div class="chaton-wa-loading">Cargando conversación...</div>';

                modal.hidden = false;
                document.body.style.overflow = 'hidden';

                try {
                    const historyRows = await fetchHistoryForLead(row);
                    renderHistory(historyRows);
                } catch (error) {
                    console.error(error);
                    waThread.innerHTML = '<div class="chaton-wa-loading">No se pudo cargar la conversación completa.</div>';
                }
            }

            function closeLeadDetail() {
                modal.hidden = true;
                document.body.style.overflow = '';
                currentLeadRow = null;
            }

            async function loadLeads() {
                statusEl.textContent = '';
                statusEl.className = 'chaton-list-status';

                if (!LEADS_ENDPOINT || LEADS_ENDPOINT === 'PON_AQUI_TU_WEBHOOK_DE_LEADS') {
                    tbody.innerHTML = '<tr><td colspan="10">Falta configurar la URL del listado de leads en n8n.</td></tr>';
                    cards.innerHTML = '<div class="chaton-prop-card"><p>Falta configurar la URL del listado de leads en n8n.</p></div>';
                    countEl.textContent = '0 leads';
                    return;
                }

                try {
                    tbody.innerHTML = '<tr><td colspan="10">Cargando leads...</td></tr>';
                    cards.innerHTML = '';

                    const response = await fetch(LEADS_ENDPOINT, { method: 'GET' });
                    if (!response.ok) {
                        throw new Error('HTTP ' + response.status);
                    }

                    const json = await response.json();
                    allRows = extractRows(json);
                    populateDynamicFilters();
                    renderRows();
                } catch (error) {
                    console.error(error);
                    tbody.innerHTML = '<tr><td colspan="10">Ocurrió un error al cargar el listado de leads.</td></tr>';
                    cards.innerHTML = '<div class="chaton-prop-card"><p>Ocurrió un error al cargar el listado de leads.</p></div>';
                    countEl.textContent = '0 leads';
                    statusEl.textContent = '❌ No se pudo cargar el listado de leads.';
                    statusEl.className = 'chaton-list-status error';
                }
            }

            async function deleteLead(clientId, phone) {
                if (!clientId) return;

                if (!DELETE_ENDPOINT || DELETE_ENDPOINT === 'PON_AQUI_TU_WEBHOOK_DELETE_DE_LEADS') {
                    alert('Falta configurar la URL del webhook para eliminar leads.');
                    return;
                }

                const typed = window.prompt(
                    '⚠️ Esta acción eliminará definitivamente el lead y su conversación.\n\nEscriba ELIMINAR para continuar:'
                );

                if (typed === null) return;
                if (String(typed).trim().toUpperCase() !== 'ELIMINAR') {
                    alert('El texto no coincide. El lead no fue eliminado.');
                    return;
                }

                try {
                    statusEl.textContent = 'Eliminando lead...';
                    statusEl.className = 'chaton-list-status';

                    const response = await fetch(DELETE_ENDPOINT, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            action: 'delete',
                            client_id: clientId,
                            telefono: phone || '',
                            delete_history: true
                        })
                    });

                    if (!response.ok) {
                        throw new Error('HTTP ' + response.status);
                    }

                    statusEl.textContent = '✅ Lead eliminado correctamente.';
                    statusEl.className = 'chaton-list-status ok';

                    if (currentLeadRow) {
                        const current = getLeadFieldMap(currentLeadRow);
                        if (String(current.client_id) === String(clientId)) {
                            closeLeadDetail();
                        }
                    }

                    await loadLeads();
                } catch (error) {
                    console.error(error);
                    statusEl.textContent = '❌ No se pudo eliminar el lead.';
                    statusEl.className = 'chaton-list-status error';
                }
            }

            document.addEventListener('click', function(e) {
                const detailBtn = e.target.closest('.chaton-lead-detail-btn');
                const deleteBtn = e.target.closest('.chaton-lead-delete-btn');

                if (detailBtn) {
                    const clientId = detailBtn.getAttribute('data-client-id');
                    if (clientId) {
                        const selectedRow = allRows.find(row => String(getLeadFieldMap(row).client_id) === String(clientId));
                        if (selectedRow) {
                            openLeadDetail(selectedRow);
                        }
                    }
                }

                if (deleteBtn) {
                    const clientId = deleteBtn.getAttribute('data-client-id');
                    const phone = deleteBtn.getAttribute('data-phone');
                    deleteLead(clientId, phone);
                }

                if (e.target === modal) {
                    closeLeadDetail();
                }
            });

            if (modalClose) modalClose.addEventListener('click', closeLeadDetail);
            if (modalFooterClose) modalFooterClose.addEventListener('click', closeLeadDetail);

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && modal && !modal.hidden) {
                    closeLeadDetail();
                }
            });

            searchInput.addEventListener('input', renderRows);
            statusFilter.addEventListener('change', renderRows);
            operationFilter.addEventListener('change', renderRows);
            locationFilter.addEventListener('change', renderRows);
            typeFilter.addEventListener('change', renderRows);
            refreshBtn.addEventListener('click', loadLeads);

            window.chatonLeadsReload = loadLeads;

            loadLeads();
        })();
        </script>
        <?php
        return ob_get_clean();
    }
