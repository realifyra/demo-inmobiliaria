        <script>
        (function() {
            const LEADS_ENDPOINT   = <?php echo json_encode($leads_endpoint); ?>;
            const HISTORY_ENDPOINT = <?php echo json_encode($history_endpoint); ?>;
            const DELETE_ENDPOINT  = <?php echo json_encode($delete_endpoint); ?>;

