      "parameters": {
        "jsCode": "const action =\n  $json.body?.action ??\n  $json.action ??\n  'upsert';\n\nif (action === 'delete') {\n  const propertyId =\n    $json.body?.property_id ??\n    $json.property_id ??\n    '';\n\n  if (!propertyId) {\n    throw new Error('No llegó property_id para eliminar.');\n  }\n\n  return [\n    {\n      json: {\n        action: 'delete',\n        property_id: String(propertyId).trim()\n      }\n    }\n  ];\n}\n\nconst raw =\n  $json.body?.payload ??\n  $json.payload ??\n  '';\n\nif (!raw) {\n  throw new Error('No llegó el payload del formulario.');\n}\n\nlet p;\ntry {\n  p = typeof raw === 'string' ? JSON.parse(raw) : raw;\n} catch (e) {\n  throw new Error('No se pudo parsear el payload JSON.');\n}\n\nreturn [\n  {\n    json: {\n      action: 'upsert',\n      property_id: p.property_id || '',\n      property_name: p.property_name || '',\n      property_type: p.property_type || '',\n      operation_type: p.operation_type || '',\n      property_status: p.property_status || '',\n      state: p.state || '',\n      city: p.city || '',\n      zone: p.zone || '',\n      address: p.address || '',\n      maps_url: p.maps_url || '',\n      price: p.price || '',\n      currency: p.currency || 'MXN',\n      land_area_m2: p.land_area_m2 || '',\n      construction_area_m2: p.construction_area_m2 || '',\n      frontage_m: p.frontage_m || '',\n      depth_m: p.depth_m || '',\n      bedrooms: p.bedrooms || '',\n      bathrooms: p.bathrooms || '',\n      half_bathrooms: p.half_bathrooms || '',\n      parking_spaces: p.parking_spaces || '',\n      short_description: p.short_description || '',\n      full_description: p.full_description || '',\n      amenities: Array.isArray(p.amenities) ? p.amenities.join(', ') : (p.amenities || ''),\n      other_amenities: p.other_amenities || '',\n      virtual_tour_url: p.virtual_tour_url || '',\n      advisor_name: p.advisor_name || '',\n      contact_phone: p.contact_phone || '',\n      internal_notes: p.internal_notes || '',\n      created_at: p.created_at || '',\n      updated_at: p.updated_at || '',\n      main_image_url: p.main_image_url || '',\n      gallery_urls: Array.isArray(p.gallery_urls) ? JSON.stringify(p.gallery_urls) : (p.gallery_urls || '')\n    }\n  }\n];"
      },
