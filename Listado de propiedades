                                    <button type="button" class="chaton-btn-detail chaton-detail-btn" data-property-id="${escapeHtml(m.property_id)}">Ver detalle</button>
                                    <button type="button" class="chaton-btn-small chaton-edit-btn" data-property-id="${escapeHtml(m.property_id)}">Editar</button>
                                    <button type="button" class="chaton-btn-danger chaton-delete-btn" data-id="${escapeHtml(m.property_id)}">Eliminar</button>
                                </div>
                            </td>
                        </tr>
                    `;
                }).join('');

                cards.innerHTML = filtered.map((row) => {
                    const m = getRowFieldMap(row);
                    const location = [m.city, m.zone, m.state].filter(Boolean).join(' · ');

                    return `
                        <div class="chaton-prop-card">
                            <div style="display:flex;justify-content:space-between;gap:10px;align-items:flex-start;">
                                <div>
                                    <h4>${escapeHtml(m.property_name)}</h4>
                                    <p>${escapeHtml(m.property_id)}</p>
                                </div>
                                <span class="chaton-status-pill ${statusClass(m.property_status)}">${escapeHtml(m.property_status || 'Sin estatus')}</span>
                            </div>

                            <div class="chaton-card-meta">
                                <div><strong>Tipo</strong>${escapeHtml(m.property_type)}</div>
                                <div><strong>Operación</strong>${escapeHtml(m.operation_type)}</div>
                                <div><strong>Ubicación</strong>${escapeHtml(location)}</div>
                                <div><strong>Precio</strong>${formatMoney(m.price, m.currency)}</div>
                                <div><strong>Asesor</strong>${escapeHtml(m.advisor_name)}</div>
                                <div><strong>Actualizado</strong>${escapeHtml(m.updated_at || m.created_at)}</div>
                            </div>

                            ${m.short_description ? `<p>${escapeHtml(m.short_description)}</p>` : ''}

                            <div class="chaton-card-actions">
                                <button type="button" class="chaton-btn-detail chaton-detail-btn" data-property-id="${escapeHtml(m.property_id)}">Ver detalle</button>
                                <button type="button" class="chaton-btn-small chaton-edit-btn" data-property-id="${escapeHtml(m.property_id)}">Editar</button>
                                <button type="button" class="chaton-btn-danger chaton-delete-btn" data-id="${escapeHtml(m.property_id)}">Eliminar</button>
                            </div>
                        </div>
                    `;
                }).join('');
            }

            async function loadProperties() {
                statusEl.textContent = '';
                statusEl.className = 'chaton-list-status';

                if (!LIST_ENDPOINT || LIST_ENDPOINT === 'PON_AQUI_TU_WEBHOOK_LIST_DE_N8N') {
                    tbody.innerHTML = '<tr><td colspan="10">Falta configurar la URL del listado en n8n.</td></tr>';
                    cards.innerHTML = '<div class="chaton-prop-card"><p>Falta configurar la URL del listado en n8n.</p></div>';
                    countEl.textContent = '0 propiedades';
                    return;
                }

                try {
                    tbody.innerHTML = '<tr><td colspan="10">Cargando propiedades...</td></tr>';
                    cards.innerHTML = '';

                    const response = await fetch(LIST_ENDPOINT, { method: 'GET' });
                    if (!response.ok) {
                        throw new Error('HTTP ' + response.status);
                    }

                    const json = await response.json();
                    allRows = extractRows(json);
                    populateDynamicFilters();
                    renderRows();

                } catch (error) {
                    console.error(error);
                    tbody.innerHTML = '<tr><td colspan="10">Ocurrió un error al cargar el listado.</td></tr>';
                    cards.innerHTML = '<div class="chaton-prop-card"><p>Ocurrió un error al cargar el listado.</p></div>';
                    countEl.textContent = '0 propiedades';
                    statusEl.textContent = '❌ No se pudo cargar el listado.';
                    statusEl.className = 'chaton-list-status error';
                }
            }

            async function deleteProperty(propertyId) {
                if (!propertyId) return;

                if (!DELETE_ENDPOINT || DELETE_ENDPOINT === 'PON_AQUI_TU_WEBHOOK_DELETE_DE_N8N') {
                    alert('Falta configurar la URL del webhook para eliminar propiedades.');
                    return;
                }

                const typed = window.prompt(
                    '⚠️ Esta acción eliminará definitivamente la propiedad.\n\nEscriba ELIMINAR para continuar:'
                );

                if (typed === null) return;

                if (String(typed).trim().toUpperCase() !== 'ELIMINAR') {
                    alert('El texto no coincide. La propiedad no fue eliminada.');
                    return;
                }

                try {
                    statusEl.textContent = 'Eliminando propiedad...';
                    statusEl.className = 'chaton-list-status';

                    const response = await fetch(DELETE_ENDPOINT, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
    action: 'delete',
    property_id: propertyId
})
                    });

                    if (!response.ok) {
                        throw new Error('HTTP ' + response.status);
                    }

                    statusEl.textContent = '✅ Propiedad eliminada correctamente.';
                    statusEl.className = 'chaton-list-status ok';

                    await loadProperties();

                } catch (error) {
                    console.error(error);
                    statusEl.textContent = '❌ No se pudo eliminar la propiedad.';
                    statusEl.className = 'chaton-list-status error';
                }
            }

            async function copyCurrentPropertyText() {
                if (!currentDetailRow) return;

                const text = buildPropertyShareText(currentDetailRow);

                try {
                    await navigator.clipboard.writeText(text);
                    alert('Texto copiado correctamente.');
                } catch (e) {
                    const textArea = document.createElement('textarea');
                    textArea.value = text;
                    document.body.appendChild(textArea);
                    textArea.select();
                    document.execCommand('copy');
                    document.body.removeChild(textArea);
                    alert('Texto copiado correctamente.');
                }
            }

            function shareCurrentPropertyWhatsApp() {
                if (!currentDetailRow) return;
                const text = buildPropertyShareText(currentDetailRow);
                window.open('https://wa.me/?text=' + encodeURIComponent(text), '_blank');
            }

            document.addEventListener('click', async function(e) {
                const editBtn = e.target.closest('.chaton-edit-btn');
                const deleteBtn = e.target.closest('.chaton-delete-btn');
                const detailBtn = e.target.closest('.chaton-detail-btn');

                if (editBtn) {
                    const propertyId = editBtn.getAttribute('data-property-id');

                    if (propertyId) {
                        const selectedRow = allRows.find(row => {
                            const m = getRowFieldMap(row);
                            return String(m.property_id) === String(propertyId);
                        });

                        if (selectedRow) {
                            await loadRowIntoForm(selectedRow);
                        }
                    }
                }

                if (deleteBtn) {
                    const propertyId = deleteBtn.getAttribute('data-id');
                    deleteProperty(propertyId);
                }

                if (detailBtn) {
                    const propertyId = detailBtn.getAttribute('data-property-id');

                    if (propertyId) {
                        const selectedRow = allRows.find(row => {
                            const m = getRowFieldMap(row);
                            return String(m.property_id) === String(propertyId);
                        });

                        if (selectedRow) {
                            openPropertyDetail(selectedRow);
                        }
                    }
                }

                if (e.target === modal) {
                    closePropertyDetail();
                }
            });

            if (modalClose) modalClose.addEventListener('click', closePropertyDetail);
            if (modalFooterClose) modalFooterClose.addEventListener('click', closePropertyDetail);
            if (copyBtn) copyBtn.addEventListener('click', copyCurrentPropertyText);
            if (waBtn) waBtn.addEventListener('click', shareCurrentPropertyWhatsApp);

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && modal && !modal.hidden) {
                    closePropertyDetail();
                }
            });

            searchInput.addEventListener('input', renderRows);
            statusFilter.addEventListener('change', renderRows);
            operationFilter.addEventListener('change', renderRows);
            cityFilter.addEventListener('change', renderRows);
            typeFilter.addEventListener('change', renderRows);
            advisorFilter.addEventListener('change', renderRows);
            refreshBtn.addEventListener('click', loadProperties);

            bindPopupTriggerElements();
            setTimeout(bindPopupTriggerElements, 1200);
            setTimeout(bindPopupTriggerElements, 3000);

            window.chatonPropsReload = loadProperties;
            window.chatonPreparePropertyFormCreate = scheduleCreateModeReset;
            window.chatonEnsureArchivedOptionInFormStatusSelect = ensureArchivedOptionInFormStatusSelect;

            loadProperties();
        })();
        </script>
        <?php
        return ob_get_clean();
    }
