            function extractRows(response) {
                if (Array.isArray(response)) return response;
                if (response && Array.isArray(response.data)) return response.data;
                if (response && Array.isArray(response.rows)) return response.rows;
                if (response && Array.isArray(response.items)) return response.items;
                return [];
            }

            function formatMoney(price, currency) {
                const amount = Number(price);
                if (isNaN(amount)) return escapeHtml(price || '');

                try {
                    return new Intl.NumberFormat('es-MX', {
                        style: 'currency',
                        currency: currency || 'MXN',
                        maximumFractionDigits: 0
                    }).format(amount);
                } catch (e) {
                    return escapeHtml(amount);
                }
            }

            function statusClass(status) {
                const val = normalizeText(status);
                if (val === 'disponible') return 'disponible';
                if (val === 'apartada') return 'apartada';
                if (val === 'vendida') return 'vendida';
                if (val === 'rentada') return 'rentada';
                if (val === 'archivada') return 'archivada';
                return 'inactiva';
            }

            function uniqueSortedValues(rows, fieldName) {
                const values = rows
                    .map(row => getRowFieldMap(row)[fieldName])
                    .filter(Boolean)
                    .map(v => String(v).trim());

                return [...new Set(values)].sort((a, b) => a.localeCompare(b, 'es'));
            }

            function populateDynamicFilters() {
                const cities = uniqueSortedValues(allRows, 'city');
                const types = uniqueSortedValues(allRows, 'property_type');
                const advisors = uniqueSortedValues(allRows, 'advisor_name');

                cityFilter.innerHTML = '<option value="">Todas las ciudades</option>' +
                    cities.map(city => `<option value="${escapeHtml(city)}">${escapeHtml(city)}</option>`).join('');

                typeFilter.innerHTML = '<option value="">Todos los tipos</option>' +
                    types.map(type => `<option value="${escapeHtml(type)}">${escapeHtml(type)}</option>`).join('');

                advisorFilter.innerHTML = '<option value="">Todos los asesores</option>' +
                    advisors.map(advisor => `<option value="${escapeHtml(advisor)}">${escapeHtml(advisor)}</option>`).join('');
            }

            function rowMatches(row, term, status, operation, city, type, advisor) {
                const m = getRowFieldMap(row);
                const normalizedStatus = normalizeText(m.property_status);

                const haystack = normalizeText([
                    m.property_id,
                    m.property_name,
                    m.property_type,
                    m.operation_type,
                    m.property_status,
                    m.state,
                    m.city,
                    m.zone,
                    m.address,
                    m.advisor_name
                ].join(' '));

                const matchesTerm = !term || haystack.includes(term);
                const matchesOperation = !operation || normalizeText(m.operation_type) === normalizeText(operation);
                const matchesCity = !city || normalizeText(m.city) === normalizeText(city);
                const matchesType = !type || normalizeText(m.property_type) === normalizeText(type);
                const matchesAdvisor = !advisor || normalizeText(m.advisor_name) === normalizeText(advisor);

                let matchesStatus = true;
                if (!status) {
                    matchesStatus = normalizedStatus !== 'archivada';
                } else {
                    matchesStatus = normalizedStatus === normalizeText(status);
                }

                return matchesTerm && matchesStatus && matchesOperation && matchesCity && matchesType && matchesAdvisor;
            }

            function buildAmenitiesHtml(m) {
                const amenities = parseAmenities(m.amenities);
                const pills = [];

                amenities.forEach(item => {
                    pills.push(`<span class="chaton-amenity-pill">${escapeHtml(item)}</span>`);
                });

                if (m.other_amenities) {
                    pills.push(`<span class="chaton-amenity-pill">${escapeHtml(m.other_amenities)}</span>`);
                }

                return pills.length
                    ? `<div class="chaton-amenities-list">${pills.join('')}</div>`
                    : '<span>Sin amenidades registradas</span>';
            }

            function buildGalleryHtml(m) {
                const gallery = parseGalleryUrls(m.gallery_urls);
                if (!gallery.length) {
                    return '<span>Sin galería registrada</span>';
                }

                return `
                    <div class="chaton-gallery-grid">
                        ${gallery.map(url => `<img src="${escapeHtml(url)}" alt="Imagen de galería">`).join('')}
                    </div>
                `;
            }

            function buildPropertyShareText(row) {
                const m = getRowFieldMap(row);
                const location = [m.city, m.zone, m.state].filter(Boolean).join(', ');
                const amenities = parseAmenities(m.amenities);
                const amenitiesText = amenities.length ? amenities.join(', ') : (m.other_amenities || '');
                const areaText = [
                    m.land_area_m2 ? `Terreno: ${m.land_area_m2} m²` : '',
                    m.construction_area_m2 ? `Construcción: ${m.construction_area_m2} m²` : ''
                ].filter(Boolean).join(' | ');
                const detailsText = [
                    m.bedrooms ? `🛏 ${m.bedrooms} hab.` : '',
                    m.bathrooms ? `🛁 ${m.bathrooms} baños` : '',
                    m.parking_spaces ? `🚗 ${m.parking_spaces} estacionamientos` : ''
                ].filter(Boolean).join(' · ');

                const lines = [
                    `Hola, te comparto esta propiedad:`,
                    '',
                    `🏡 *${m.property_name || 'Propiedad disponible'}*`,
                    m.property_type ? `🏷️ Tipo: ${m.property_type}` : '',
                    m.operation_type ? `🔁 Operación: ${m.operation_type}` : '',
                    m.property_status ? `✅ Estatus: ${m.property_status}` : '',
                    location ? `📍 Ubicación: ${location}` : '',
                    m.price ? `💰 Precio: ${formatMoney(m.price, m.currency).replace(/&amp;/g, '&')}` : '',
                    areaText ? `📐 ${areaText}` : '',
                    detailsText ? detailsText : '',
                    m.short_description ? `📝 ${m.short_description}` : '',
                    amenitiesText ? `✨ Amenidades: ${amenitiesText}` : '',
                    m.maps_url ? `🗺️ Maps: ${m.maps_url}` : '',
                    m.virtual_tour_url ? `🎥 Tour virtual: ${m.virtual_tour_url}` : '',
                    m.contact_phone ? `📲 Contacto: ${m.contact_phone}` : '',
                    m.advisor_name ? `👤 Asesor: ${m.advisor_name}` : ''
                ].filter(Boolean);

                return lines.join('\n');
            }

            function setFormValue(id, value) {
                const el = document.getElementById(id);
                if (!el) return;
                el.value = value || '';
            }

            function clearAmenityChecks() {
                document.querySelectorAll('input[name="amenities[]"]').forEach(el => {
                    el.checked = false;
                });
            }

            function getNowFormatted() {
                const now = new Date();
                const pad = n => (n < 10 ? '0' + n : n);
                return now.getFullYear() + '-' +
                    pad(now.getMonth() + 1) + '-' +
                    pad(now.getDate()) + ' ' +
                    pad(now.getHours()) + ':' +
                    pad(now.getMinutes()) + ':' +
                    pad(now.getSeconds());
            }

            function generatePropertyId() {
                const now = new Date();
                const pad = n => (n < 10 ? '0' + n : n);
                return 'PROP-' +
                    now.getFullYear().toString() +
                    pad(now.getMonth() + 1) +
                    pad(now.getDate()) + '-' +
                    pad(now.getHours()) +
                    pad(now.getMinutes()) +
                    pad(now.getSeconds());
            }

            function getPropertyForm() {
                return document.getElementById('chaton-property-form');
            }

            function waitForElement(selector, timeout = 7000, interval = 120) {
                return new Promise((resolve) => {
                    const start = Date.now();

                    const timer = setInterval(() => {
                        const el = document.querySelector(selector);

                        if (el) {
                            clearInterval(timer);
                            resolve(el);
                            return;
                        }

                        if (Date.now() - start >= timeout) {
                            clearInterval(timer);
                            resolve(null);
                        }
                    }, interval);
                });
            }

            function clearCreateModeTimers() {
                createModeTimers.forEach(timer => clearTimeout(timer));
                createModeTimers = [];
            }

            function ensureArchivedOptionInFormStatusSelect() {
                const statusSelect = document.getElementById('property_status');
                if (!statusSelect) return;

                const hasArchived = Array.from(statusSelect.options).some(opt => normalizeText(opt.value) === 'archivada');
                if (!hasArchived) {
                    const option = document.createElement('option');
                    option.value = 'Archivada';
                    option.textContent = 'Archivada';
                    statusSelect.appendChild(option);
                }
            }

            function setFormMode(mode) {
                const form = getPropertyForm();
                if (!form) return;

                ensureArchivedOptionInFormStatusSelect();

                const headerTitle = form.querySelector('.chaton-form-header h2');
                const headerText = form.querySelector('.chaton-form-header p');
                const submitBtn = form.querySelector('.chaton-form-actions button[type="submit"], .chaton-form-actions .chaton-btn-primary, button[type="submit"]');

                if (headerTitle) {
                    if (!headerTitle.dataset.originalText) {
                        headerTitle.dataset.originalText = headerTitle.textContent.trim();
                    }
                    headerTitle.textContent = mode === 'edit' ? 'Editar propiedad' : headerTitle.dataset.originalText;
                }

                if (headerText) {
                    if (!headerText.dataset.originalText) {
                        headerText.dataset.originalText = headerText.textContent.trim();
                    }
                    headerText.textContent = mode === 'edit'
                        ? 'Actualiza la información y guarda los cambios de esta propiedad.'
                        : headerText.dataset.originalText;
                }

                if (submitBtn) {
                    if (!submitBtn.dataset.originalText) {
                        submitBtn.dataset.originalText = submitBtn.textContent.trim();
                    }
                    submitBtn.textContent = mode === 'edit' ? 'Actualizar propiedad' : submitBtn.dataset.originalText;
                }

                form.dataset.mode = mode;
            }

            async function prepareFormForCreate() {
                let form = getPropertyForm();
                if (!form) {
                    form = await waitForElement('#chaton-property-form', 6000, 120);
                }
                if (!form) return;

                if (typeof form.reset === 'function') {
                    form.reset();
                }

                clearAmenityChecks();
                ensureArchivedOptionInFormStatusSelect();

                setFormValue('property_id', generatePropertyId());
                setFormValue('created_at', getNowFormatted());
                setFormValue('updated_at', getNowFormatted());

                const statusSelect = document.getElementById('property_status');
                if (statusSelect) {
                    if (Array.from(statusSelect.options).some(opt => normalizeText(opt.value) === 'disponible')) {
                        statusSelect.value = 'Disponible';
                    } else {
                        statusSelect.selectedIndex = 0;
                    }
                }

                const formStatus = document.getElementById('chaton-form-status');
                if (formStatus) {
                    formStatus.textContent = '';
                    formStatus.className = 'chaton-form-status';
                }

                setFormMode('create');
            }

            function scheduleCreateModeReset() {
                clearCreateModeTimers();

                const delays = [0, 250, 700, 1300, 2200];
                delays.forEach(delay => {
                    const timer = setTimeout(() => {
                        prepareFormForCreate();
                    }, delay);
                    createModeTimers.push(timer);
                });
            }

            function bindPopupTriggerElements() {
                document.querySelectorAll(PROPERTY_POPUP_TRIGGER_SELECTOR).forEach(el => {
                    if (el.dataset.chatonBound === '1') return;
                    el.dataset.chatonBound = '1';

                    el.addEventListener('click', function() {
                        if (suppressNextPopupTriggerCreateReset) {
                            suppressNextPopupTriggerCreateReset = false;
                            return;
                        }
                        scheduleCreateModeReset();
                    }, true);
                });
            }

            function openPropertyPopup(fromEdit = false) {
                const trigger = document.querySelector(PROPERTY_POPUP_TRIGGER_SELECTOR);
                if (trigger) {
                    if (fromEdit) {
                        suppressNextPopupTriggerCreateReset = true;
                    }
                    trigger.click();
                    return true;
                }
                return false;
            }

            async function loadRowIntoForm(row) {
                clearCreateModeTimers();

                let form = getPropertyForm();

                if (!form) {
                    openPropertyPopup(true);
                    form = await waitForElement('#chaton-property-form', 7000, 150);
                }

                if (!form) {
                    alert('No se encontró el formulario del popup. Revisa que el botón que abre el popup tenga la clase "chaton-open-prop-popup".');
                    return;
                }

                ensureArchivedOptionInFormStatusSelect();
                setFormMode('edit');

                const m = getRowFieldMap(row);

                setFormValue('property_id', m.property_id);
                setFormValue('property_name', m.property_name);
                setFormValue('property_type', m.property_type);
                setFormValue('operation_type', m.operation_type);
                setFormValue('property_status', m.property_status);

                setFormValue('state', m.state);
                setFormValue('city', m.city);
                setFormValue('zone', m.zone);
                setFormValue('address', m.address);
                setFormValue('maps_url', m.maps_url);

                setFormValue('price', m.price);
                setFormValue('currency', m.currency || 'MXN');
                setFormValue('land_area_m2', m.land_area_m2);
                setFormValue('construction_area_m2', m.construction_area_m2);
                setFormValue('frontage_m', m.frontage_m);
                setFormValue('depth_m', m.depth_m);

                setFormValue('bedrooms', m.bedrooms);
                setFormValue('bathrooms', m.bathrooms);
                setFormValue('half_bathrooms', m.half_bathrooms);
                setFormValue('parking_spaces', m.parking_spaces);

                setFormValue('short_description', m.short_description);
                setFormValue('full_description', m.full_description);
                setFormValue('other_amenities', m.other_amenities);
                setFormValue('virtual_tour_url', m.virtual_tour_url);

                setFormValue('advisor_name', m.advisor_name);
                setFormValue('contact_phone', m.contact_phone);
                setFormValue('internal_notes', m.internal_notes);
                setFormValue('created_at', m.created_at);
                setFormValue('updated_at', getNowFormatted());

                clearAmenityChecks();
                const amenities = parseAmenities(m.amenities);
                if (amenities.length) {
                    document.querySelectorAll('input[name="amenities[]"]').forEach(el => {
                        if (amenities.includes(el.value)) {
                            el.checked = true;
                        }
                    });
                }

                const formStatus = document.getElementById('chaton-form-status');
                if (formStatus) {
                    formStatus.textContent = 'Modo edición: se cargó la propiedad "' + (m.property_name || '') + '". Guarda el formulario para actualizarla.';
                    formStatus.className = 'chaton-form-status ok';
                }

                setTimeout(() => {
                    const firstField = document.getElementById('property_name');
                    if (firstField) firstField.focus();
                }, 250);
            }

