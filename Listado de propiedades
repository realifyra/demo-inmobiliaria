if ( ! function_exists('chaton_user_can_manage_properties') ) {
    function chaton_user_can_manage_properties() {
        if ( ! is_user_logged_in() ) {
            return false;
        }

        $user = wp_get_current_user();
        $allowed_roles = array('administrator', 'asesor', 'demo');

        if ( empty($user->roles) ) {
            return false;
        }

        foreach ( $user->roles as $role ) {
            if ( in_array($role, $allowed_roles, true) ) {
                return true;
            }
        }

        return false;
    }
}

